        }, f, indent=2)

def compare_with_previous_week(current_results, prev_week_data):
    if not prev_week_data or 'picks' not in prev_week_data:
        return []
    recommendations = []
    prev_picks = {pick['Stock']: pick for pick in prev_week_data['picks']}
    for stock in current_results['Stock']:
        if stock in prev_picks:
            prev_pick = prev_picks[stock]
            current_row = current_results[current_results['Stock'] == stock].iloc[0]
            prev_confidence = prev_pick['Confidence']
            current_confidence = current_row['Confidence']
            if current_confidence >= 90:
                action = 'ADD ⬆️' if current_confidence > prev_confidence else 'HOLD ✅'
            elif current_confidence >= 75:
                action = 'HOLD ➖'
            else:
                action = 'SELL ⬇️'
            recommendations.append({
                'Stock': stock,
                'Previous_Confidence': prev_confidence,
                'Current_Confidence': current_confidence,
                'Recommendation': action,
                'Price_Change_%': round(((current_row['Close'] - prev_pick['Close']) / prev_pick['Close']) * 100, 2)
            })
    return recommendations

