    df = pd.DataFrame(results).sort_values('Confidence', ascending=False).reset_index(drop=True)

    prev_week = load_previous_week()
    recommendations = compare_with_previous_week(df, prev_week)

    print(f"✅ Found {len(df)} high-confidence opportunities!")
    print()
    print("🏆 TOP PICKS:")
    print()
    print(df[['Stock', 'Close', 'Signal', 'Confidence', 'RSI', 'Volume_Spike', 'Target', 'Stop_Loss', 'Upside_%']].to_string(index=False))

    if recommendations:
        print()
        print("=" * 80)
        print("📈 PREVIOUS WEEK COMPARISON:")
        print()
        rec_df = pd.DataFrame(recommendations)
        print(rec_df.to_string(index=False))

    timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')

    csv_filename = os.path.join(REPORTS_DIR, f'swing_trading_report_{timestamp}.csv')
    df.to_csv(csv_filename, index=False)
    print()
    print(f"💾 CSV Report saved: {csv_filename}")

    html_filename = os.path.join(REPORTS_DIR, f'swing_trading_report_{timestamp}.html')
    html_content = generate_html_report(df, recommendations)
    with open(html_filename, 'w', encoding='utf-8') as f:
        f.write(html_content)
    print(f"💾 HTML Report saved: {html_filename}")

    if EMAIL_CONFIG['send_reports']:
        print()
        print("=" * 40)
        email_success = send_email_report(html_content, csv_filename, len(df))
        if email_success:
            print("🎉 Email report delivered successfully!")
        else:
            print("⚠️ Email delivery failed, but reports are saved locally")
        print("=" * 40)

    save_current_week(df)
    print(f"💾 Top 5 picks saved for next week comparison")

    print()
    print("=" * 80)
    print("✅ Analysis Complete!")
    if EMAIL_CONFIG['send_reports']:
        print("📧 Email report sent with HTML and CSV attachments")
    print("=" * 80)

if __name__ == "__main__":
    main()
