def send_email_report(html_content, csv_filename, results_count):
    if not EMAIL_CONFIG['send_reports']:
        print("📧 Email sending disabled in configuration")
        return False
    try:
        msg = MIMEMultipart('alternative')
        timestamp = datetime.now().strftime('%Y-%m-%d')
        msg['From'] = EMAIL_CONFIG['sender_email']
        msg['To'] = EMAIL_CONFIG['recipient_email']
        msg['Subject'] = f'🎯 Swing Trading Report - {results_count} Opportunities Found | {timestamp}'

        text_body = f"""
🎯 SWING TRADING SCANNER REPORT
Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S IST')}

📊 SUMMARY:
✅ High Confidence Opportunities Found: {results_count}
🎯 Confidence Threshold: ≥{config['CONFIDENCE_THRESHOLD']}%
