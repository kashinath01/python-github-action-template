# ------------------ Indicator calculation helpers ------------------

def calculate_rsi(data, period):
    delta = data['Close'].diff()
    gain = (delta.where(delta > 0, 0)).rolling(window=period).mean()
    loss = (-delta.where(delta < 0, 0)).rolling(window=period).mean()
    rs = gain / loss
    rsi = 100 - (100 / (1 + rs))
    return rsi

def calculate_ema(data, period):
    return data['Close'].ewm(span=period, adjust=False).mean()

def calculate_sma(data, period):
    return data['Close'].rolling(window=period).mean()

def check_volume_spike(data, multiplier):
    avg_volume = data['Volume'].iloc[-20:-1].mean()
    recent_volume = data['Volume'].iloc[-1]
    return recent_volume > (avg_volume * multiplier)

def calculate_confidence(signals):
    total = len(signals)
    positive = sum(signals.values())
    return round((positive / total) * 100, 2)

def analyze_stock(stock_symbol):
    try:
        ticker = yf.Ticker(stock_symbol)
        data = ticker.history(period='6mo')
        if len(data) < config['LOOKBACK_PERIOD']:
            return None

        data[f'SMA_{config["SMA_SHORT"]}'] = calculate_sma(data, config['SMA_SHORT'])
        data[f'SMA_{config["SMA_LONG"]}'] = calculate_sma(data, config['SMA_LONG'])
        data[f'EMA_{config["EMA_SHORT"]}'] = calculate_ema(data, config['EMA_SHORT'])
        data[f'EMA_{config["EMA_LONG"]}'] = calculate_ema(data, config['EMA_LONG'])
        data['RSI'] = calculate_rsi(data, config['RSI_PERIOD'])
        data['Volume_MA'] = data['Volume'].rolling(window=20).mean()

        latest = data.iloc[-1]
        prev = data.iloc[-2]

        signals = {}
        sma_short = f'SMA_{config["SMA_SHORT"]}'
        sma_long = f'SMA_{config["SMA_LONG"]}'
        ema_short = f'EMA_{config["EMA_SHORT"]}'
        ema_long = f'EMA_{config["EMA_LONG"]}'

        signals['SMA_Breakout'] = int(data[sma_short].iloc[-2] <= data[sma_long].iloc[-2] and data[sma_short].iloc[-1] > data[sma_long].iloc[-1])
        signals['Price_Above_SMA'] = int(latest['Close'] > latest[sma_short] and latest['Close'] > latest[sma_long])
        signals['EMA_Golden_Cross'] = int(data[ema_short].iloc[-2] <= data[ema_long].iloc[-2] and data[ema_short].iloc[-1] > data[ema_long].iloc[-1])
        signals['EMA_Bullish'] = int(latest[ema_short] > latest[ema_long])
        signals['RSI_Optimal'] = int(config['RSI_OVERSOLD'] < latest['RSI'] < config['RSI_OVERBOUGHT'])
        signals['Volume_Spike'] = int(check_volume_spike(data, config['VOLUME_SPIKE_MULTIPLIER']))
        signals['Bullish_Candle'] = int(latest['Close'] > latest['Open'])
        signals['Higher_Highs'] = int(data['High'].tail(5).iloc[-1] > data['High'].tail(5).iloc[0])

        confidence = calculate_confidence(signals)

        if confidence >= 90:
            signal = 'STRONG BUY'
        elif confidence >= config['CONFIDENCE_THRESHOLD']:
            signal = 'BUY'
        elif confidence >= 60:
            signal = 'WEAK BUY'
        else:
            signal = 'HOLD'

        current_price = latest['Close']
        atr = data['High'].rolling(14).max() - data['Low'].rolling(14).min()
        stop_loss = current_price - (atr.iloc[-1] * 0.5)
        target = current_price + (current_price - stop_loss) * 2

        return {
            'Stock': stock_symbol.replace('.NS', ''),
            'Close': round(current_price, 2),
            'Signal': signal,
            'Confidence': confidence,
            'RSI': round(latest['RSI'], 2),
            f'SMA_{config["SMA_SHORT"]}': round(latest[sma_short], 2),
            f'SMA_{config["SMA_LONG"]}': round(latest[sma_long], 2),
            f'EMA_{config["EMA_SHORT"]}': round(latest[ema_short], 2),
            f'EMA_{config["EMA_LONG"]}': round(latest[ema_long], 2),
            'Volume_Spike': '✅' if signals['Volume_Spike'] else '❌',
            'Target': round(target, 2),
            'Stop_Loss': round(stop_loss, 2),
            'Upside_%': round(((target - current_price) / current_price) * 100, 2),
            'Signals': signals
        }
    except Exception as e:
        print(f"❌ Error analyzing {stock_symbol}: {e}")
        return None

